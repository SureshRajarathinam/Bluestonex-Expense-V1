<mvc:View
  controllerName="com.bluestonex.expense.approval.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
  xmlns:dnd="sap.ui.core.dnd"
  xmlns:vbm="sap.ui.vbm"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
  height="100%"
  busy="{dash>/busy}">

  <ScrollContainer height="100%" vertical="true" horizontal="false">

    <!-- ── Filters (drive every card) ─────────────────────────────────────── -->
    <VBox class="bsxCard bsxPremiumCard">
      <OverflowToolbar class="bsxCardPad">
        <Title text="{i18n>tabDashboard}" class="bsxCardTitle" level="H3" />
        <ToolbarSpacer />
        <SegmentedButton selectedKey="{dash>/preset}" selectionChange=".onPreset">
          <items>
            <SegmentedButtonItem key="D" text="{i18n>dashDay}" />
            <SegmentedButtonItem key="W" text="{i18n>dashWeek}" />
            <SegmentedButtonItem key="M" text="{i18n>dashMonth}" />
            <SegmentedButtonItem key="Y" text="{i18n>dashYear}" />
          </items>
        </SegmentedButton>
        <DateRangeSelection id="dashRange" dateValue="{dash>/fromDate}" secondDateValue="{dash>/toDate}" displayFormat="dd MMM yyyy" change=".onRange" width="18rem" />
        <Label text="{i18n>filterCountry}" class="bsxFieldLbl sapUiTinyMarginBegin" />
        <Select selectedKey="{dash>/country}" change=".onCountry" width="8rem" autoAdjustWidth="false"
          items="{ path: '/Countries', templateShareable: false }">
          <core:Item key="{code}" text="{description}" />
        </Select>
        <Button text="{i18n>btnRefresh}" icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>dashRefreshTip}" press=".onRefresh" />
      </OverflowToolbar>
    </VBox>

    <MessageStrip visible="{= !${dash>/hasData} || !!${dash>/error} }"
                  text="{= ${dash>/error} ? ${dash>/error} : ${i18n>dashNoData} }"
                  type="{= ${dash>/error} ? 'Warning' : 'Information' }"
                  showIcon="true" class="bsxCardPad" />

    <!-- ── Layer 1 · KPI tiles ────────────────────────────────────────────── -->
    <!-- Each row shares groupName 'cards' so any card can be dragged to any row. -->
    <FlexBox id="dashRow0" wrap="Wrap" alignItems="Stretch" class="bsxCardRow" renderType="Bare">
      <dragDropConfig>
        <dnd:DragInfo groupName="cards" sourceAggregation="items" />
        <dnd:DropInfo groupName="cards" targetAggregation="items" dropPosition="Between" drop=".onCardDrop" />
      </dragDropConfig>
      <VBox class="bsxCard bsxKpi bsxKpiTile bsxDragCard">
        <customData><core:CustomData key="card" value="awaiting" /></customData>
        <Text text="{i18n>dashAwaiting}" class="bsxFieldLbl" />
        <Title text="{dash>/awaitingTotal}" level="H1" class="bsxKpiNum bsxKpiWait" />
        <core:HTML content="{dash>/awaitingPills}" />
      </VBox>
      <VBox class="bsxCard bsxKpi bsxKpiTile bsxDragCard">
        <customData><core:CustomData key="card" value="approved" /></customData>
        <Text text="{i18n>dashApproved}" class="bsxFieldLbl" />
        <Title text="{dash>/approvedTotal}" level="H1" class="bsxKpiNum bsxKpiOk" />
        <core:HTML content="{dash>/approvedPills}" />
      </VBox>
      <VBox class="bsxCard bsxKpi bsxKpiTile bsxDragCard">
        <customData><core:CustomData key="card" value="rejected" /></customData>
        <Text text="{i18n>dashRejected}" class="bsxFieldLbl" />
        <Title text="{dash>/rejectedTotal}" level="H1" class="bsxKpiNum bsxKpiNo" />
        <core:HTML content="{dash>/rejectedPills}" />
      </VBox>
    </FlexBox>

    <!-- ── Layer 2 · Spend by category (team card removed; slot reserved) ───── -->
    <FlexBox id="dashRow1" wrap="Wrap" alignItems="Stretch" class="bsxCardRow" renderType="Bare">
      <dragDropConfig>
        <dnd:DragInfo groupName="cards" sourceAggregation="items" />
        <dnd:DropInfo groupName="cards" targetAggregation="items" dropPosition="Between" drop=".onCardDrop" />
      </dragDropConfig>
      <VBox class="bsxCard bsxPremiumCard bsxChartCard bsxDragCard">
        <customData><core:CustomData key="card" value="spendCat" /></customData>
        <Title text="{= ${i18n>dashSpendCat} + ' (' + ${dash>/curLabel} + ')' }" class="bsxCardTitle bsxCardPad" level="H3" />
        <core:HTML content="{dash>/catHtml}" />
      </VBox>
    </FlexBox>

    <!-- ── Layer 3 · Approved vs Rejected + Trend ──────────────────────────── -->
    <!-- alignItems="Stretch": cards in a row share one (even) height. The Trend
         card's footer is pinned to the card bottom (.bsxChartCard > .bsxCardFoot
         { margin-top:auto }) so the leftover height sits as headroom under the
         chart instead of a dangling gap beneath the footer. -->
    <FlexBox id="dashRow2" wrap="Wrap" alignItems="Stretch" class="bsxCardRow" renderType="Bare">
      <dragDropConfig>
        <dnd:DragInfo groupName="cards" sourceAggregation="items" />
        <dnd:DropInfo groupName="cards" targetAggregation="items" dropPosition="Between" drop=".onCardDrop" />
      </dragDropConfig>
      <!-- Top 5 claimants — name (left) + blue-shaded amount bar (right). -->
      <VBox class="bsxCard bsxPremiumCard bsxChartCard bsxDragCard">
        <customData><core:CustomData key="card" value="claimants" /></customData>
        <Title text="{i18n>dashTopClaimants}" class="bsxCardTitle bsxCardPad" level="H3" />
        <core:HTML content="{dash>/claimantsHtml}" />
      </VBox>

      <!-- Total reimbursed spend — approved spend by category as a sap.viz donut:
           each slice highlightable, labelled "Category (xx.x%)", with a legend.
           Data + per-currency styling come from the controller (_styleDonut). -->
      <VBox class="bsxCard bsxPremiumCard bsxChartCard bsxDragCard">
        <customData><core:CustomData key="card" value="totalExp" /></customData>
        <Title text="{i18n>dashTopItems}" class="bsxCardTitle bsxCardPad" level="H3" />
        <viz:VizFrame id="spendDonut" vizType="donut" width="100%" height="320px"
          class="bsxCardPad" visible="{dash>/hasDonut}"
          uiConfig="{applicationSet:'fiori'}">
          <viz:dataset>
            <vizData:FlattenedDataset data="{dash>/donutData}">
              <vizData:dimensions>
                <vizData:DimensionDefinition name="Category" value="{dash>title}" />
              </vizData:dimensions>
              <vizData:measures>
                <vizData:MeasureDefinition name="Amount" value="{dash>value}" />
              </vizData:measures>
            </vizData:FlattenedDataset>
          </viz:dataset>
          <viz:feeds>
            <vizFeeds:FeedItem uid="size" type="Measure" values="Amount" />
            <vizFeeds:FeedItem uid="color" type="Dimension" values="Category" />
          </viz:feeds>
        </viz:VizFrame>
        <Text text="{i18n>dashNoData}" class="bsxTlEmpty bsxCardPad" visible="{= !${dash>/hasDonut} }" />
      </VBox>

      <!-- Spend by country (geographic choropleth). Primary renderer = AnalyticMap.
           FALLBACK (if the map renders blank live): replace the <vbm:AnalyticMap>
           block below with:  <core:HTML content="{dash>/geoSvgHtml}" />
           (same /geo model; geoSvgHtml is already built in the controller). -->
      <VBox class="bsxCard bsxPremiumCard bsxHalfCard bsxDragCard">
        <customData><core:CustomData key="card" value="geo" /></customData>
        <Title text="{i18n>dashGeo}" class="bsxCardTitle bsxCardPad" level="H3" />
        <!-- initialZoom/initialPosition = fully zoomed out (whole-world view) on load. -->
        <vbm:AnalyticMap id="geoMap" regions="{dash>/geo}" width="100%" height="300px" class="bsxCardPad"
          initialZoom="1" initialPosition="10;25;0">
          <vbm:regions>
            <vbm:Region code="{dash>code}" color="{dash>color}" tooltip="{dash>tooltip}" click=".onRegionClick" />
          </vbm:regions>
        </vbm:AnalyticMap>
        <core:HTML content="{dash>/geoLegendHtml}" />
      </VBox>

      <!-- Trend — kept LAST in the row per the requested layout. -->
      <VBox class="bsxCard bsxPremiumCard bsxChartCard bsxDragCard">
        <customData><core:CustomData key="card" value="trend" /></customData>
        <Title text="{i18n>dashTrend}" class="bsxCardTitle bsxCardPad" level="H3" />
        <core:HTML content="{dash>/trendHtml}" />
        <core:HTML content="{dash>/trendFootHtml}" />
      </VBox>
    </FlexBox>

  </ScrollContainer>
</mvc:View>
