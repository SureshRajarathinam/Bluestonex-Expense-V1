<mvc:View
  controllerName="com.bluestonex.expense.approval.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
  height="100%"
  busy="{dash>/busy}">

  <ScrollContainer height="100%" vertical="true" horizontal="false">

    <!-- ── Filters (drive every card) ─────────────────────────────────────── -->
    <VBox class="bsxCard bsxPremiumCard">
      <Title text="{i18n>tabDashboard}" class="bsxCardTitle bsxCardPad" level="H3" />
      <l:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="0" class="bsxCardPad">
        <VBox>
          <Label text="{i18n>dashFrom}" class="bsxFieldLbl" />
          <DatePicker value="{dash>/from}" valueFormat="yyyy-MM-dd" displayFormat="dd MMM yyyy" change=".onDateChange" width="100%" />
        </VBox>
        <VBox>
          <Label text="{i18n>dashTo}" class="bsxFieldLbl" />
          <DatePicker value="{dash>/to}" valueFormat="yyyy-MM-dd" displayFormat="dd MMM yyyy" change=".onDateChange" width="100%">
            <customData><core:CustomData key="edge" value="to" /></customData>
          </DatePicker>
        </VBox>
        <VBox>
          <Label text="{i18n>filterCountry}" class="bsxFieldLbl" />
          <SegmentedButton selectedKey="{dash>/country}" selectionChange=".onCountry">
            <items>
              <SegmentedButtonItem key="ALL" text="{i18n>all}" />
              <SegmentedButtonItem key="UK" text="UK" />
              <SegmentedButtonItem key="IN" text="India" />
            </items>
          </SegmentedButton>
        </VBox>
        <VBox visible="{dash>/showCurToggle}">
          <Label text="{i18n>dashCurrency}" class="bsxFieldLbl" />
          <SegmentedButton selectedKey="{dash>/cur}" selectionChange=".onCurrency">
            <items>
              <SegmentedButtonItem key="£" text="£" />
              <SegmentedButtonItem key="₹" text="₹" />
            </items>
          </SegmentedButton>
        </VBox>
      </l:Grid>
      <Text text="{dash>/rangeText}" class="bsxKpiSub bsxCardPad" />
    </VBox>

    <MessageStrip visible="{= !${dash>/hasData} || !!${dash>/error} }"
                  text="{= ${dash>/error} ? ${dash>/error} : ${i18n>dashNoData} }"
                  type="{= ${dash>/error} ? 'Warning' : 'Information' }"
                  showIcon="true" class="bsxCardPad" />

    <!-- ── Layer 1 · KPI tiles (flex row — hidden tiles collapse, no gaps) ── -->
    <FlexBox wrap="Wrap" alignItems="Stretch" class="bsxCardRow" renderType="Bare">
      <VBox class="bsxCard bsxKpi bsxKpiTile">
        <Text text="{i18n>dashAwaiting}" class="bsxFieldLbl" />
        <Title text="{dash>/awaitingTotal}" level="H1" class="bsxKpiNum bsxKpiWait" />
        <core:HTML content="{dash>/awaitingPills}" />
      </VBox>
      <VBox class="bsxCard bsxKpi bsxKpiTile">
        <Text text="{i18n>dashApproved}" class="bsxFieldLbl" />
        <Title text="{dash>/approvedTotal}" level="H1" class="bsxKpiNum bsxKpiOk" />
        <core:HTML content="{dash>/approvedPills}" />
      </VBox>
      <VBox class="bsxCard bsxKpi bsxKpiTile">
        <Text text="{i18n>dashRejected}" class="bsxFieldLbl" />
        <Title text="{dash>/rejectedTotal}" level="H1" class="bsxKpiNum bsxKpiNo" />
        <core:HTML content="{dash>/rejectedPills}" />
      </VBox>
      <VBox class="bsxCard bsxKpi bsxKpiTile" visible="{dash>/showGbp}">
        <Text text="{i18n>dashReimbursedUK}" class="bsxFieldLbl" />
        <Title text="{dash>/reimbursedGbp}" level="H2" class="bsxKpiNum" />
        <Text text="{i18n>dashApprovedClaims}" class="bsxKpiSub" />
      </VBox>
      <VBox class="bsxCard bsxKpi bsxKpiTile" visible="{dash>/showInr}">
        <Text text="{i18n>dashReimbursedIN}" class="bsxFieldLbl" />
        <Title text="{dash>/reimbursedInr}" level="H2" class="bsxKpiNum" />
        <Text text="{i18n>dashApprovedClaims}" class="bsxKpiSub" />
      </VBox>
    </FlexBox>

    <!-- ── Layer 2 · Spend by category + Spend by team ─────────────────────── -->
    <FlexBox wrap="Wrap" alignItems="Stretch" class="bsxCardRow" renderType="Bare">
      <VBox class="bsxCard bsxPremiumCard bsxChartCard">
        <Title text="{= ${i18n>dashSpendCat} + ' (' + ${dash>/curLabel} + ')' }" class="bsxCardTitle bsxCardPad" level="H3" />
        <core:HTML content="{dash>/catHtml}" />
      </VBox>
      <VBox class="bsxCard bsxPremiumCard bsxChartCard">
        <Title text="{= ${i18n>dashSpendTeam} + ' (' + ${dash>/curLabel} + ')' }" class="bsxCardTitle bsxCardPad" level="H3" />
        <core:HTML content="{dash>/teamHtml}" />
        <Text text="{i18n>dashTeamHint}" class="bsxKpiSub bsxCardPad" />
      </VBox>
    </FlexBox>

    <!-- ── Layer 3 · Approved vs Rejected + Trend ──────────────────────────── -->
    <FlexBox wrap="Wrap" alignItems="Stretch" class="bsxCardRow" renderType="Bare">
      <VBox class="bsxCard bsxPremiumCard bsxChartCard">
        <Title text="{i18n>dashApprRej}" class="bsxCardTitle bsxCardPad" level="H3" />
        <core:HTML content="{dash>/avrHtml}" />
      </VBox>
      <VBox class="bsxCard bsxPremiumCard bsxChartCard">
        <Title text="{i18n>dashTrend}" class="bsxCardTitle bsxCardPad" level="H3" />
        <core:HTML content="{dash>/trendHtml}" />
        <Text text="{i18n>dashTrendHint}" class="bsxKpiSub bsxCardPad" />
      </VBox>
    </FlexBox>
  </ScrollContainer>
</mvc:View>
