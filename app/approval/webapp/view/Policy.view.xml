<mvc:View
  controllerName="com.bluestonex.expense.approval.controller.Policy"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  height="100%">

  <!-- ══ Policy for the selected country (UK by default) ══════════════════ -->
  <VBox class="bsxCard bsxPremiumCard">
    <OverflowToolbar class="bsxCardPad">
      <Title text="{ui>/title}" class="bsxCardTitle" level="H3" />
      <ToolbarSpacer />
      <Label text="{i18n>filterCountry}" class="bsxFieldLbl sapUiTinyMarginEnd" />
      <Select selectedKey="{ui>/country}" change=".onSwitchCountry" width="9rem" autoAdjustWidth="false"
        items="{ path: '/Countries', templateShareable: false }">
        <core:Item key="{code}" text="{description}" />
      </Select>
      <Button text="{i18n>btnEdit}" icon="sap-icon://edit" type="Emphasized" class="bsxPill" visible="{ui>/display}" press=".onEdit" />
      <Button text="{i18n>btnCancel}" class="bsxPill" visible="{ui>/editing}" press=".onCancel" />
      <Button text="{i18n>btnSave}" type="Emphasized" class="bsxPill" visible="{ui>/editing}" press=".onSave" />
    </OverflowToolbar>

    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsM="2" columnsL="2" class="bsxCardPad">
      <f:content>
        <Label text="{i18n>lblPolicyName}" />
        <Input value="{policyName}" editable="{ui>/editing}" />
        <!-- Currency is fixed per country (UK = GBP, India = INR); shown read-only
             so the limit/rate figures below are never ambiguous. -->
        <Label text="{i18n>lblCurrency}" />
        <Text text="{= ${ui>/isUK} ? 'GBP (£)' : 'INR (₹)' }" />
        <!-- Starting Claim Number for this country (e.g. UKEXP1 / INEXP1). New
             claims take this value first, then increment. -->
        <Label text="{i18n>lblClaimStart}" />
        <Input value="{claimNumberStart}" editable="{ui>/editing}" placeholder="{= ${ui>/isUK} ? 'e.g. UKEXP1' : 'e.g. INEXP1' }" />
        <Label text="{i18n>lblVat}" visible="{ui>/isUK}" required="true" />
        <Input value="{vatRate}" type="Number" editable="{ui>/editing}" visible="{ui>/isUK}" />
        <Label text="{i18n>lblGst}" visible="{ui>/isIN}" required="true" />
        <Input value="{gstRate}" type="Number" editable="{ui>/editing}" visible="{ui>/isIN}" />
        <Label text="{= ${i18n>lblMileage} + (${ui>/isUK} ? ' — £/mile' : ' — ₹/mile') }" />
        <Input value="{mileageRate}" type="Number" editable="{ui>/editing}" />
        <Label text="{= ${i18n>lblHotel} + (${ui>/isUK} ? ' (£)' : ' (₹)') }" />
        <!-- No type="Number" (see my-expenses): grouped values ≥ 1000 wouldn't stick. -->
        <Input value="{hotelDailyLimit}" editable="{ui>/editing}" />
        <Label text="{= ${i18n>lblMeal} + (${ui>/isUK} ? ' (£)' : ' (₹)') }" />
        <Input value="{mealDailyLimit}" editable="{ui>/editing}" />
        <Label text="{= ${i18n>lblThreshold} + (${ui>/isUK} ? ' (£)' : ' (₹)') }" />
        <Input value="{receiptThreshold}" editable="{ui>/editing}" />
      </f:content>
    </f:SimpleForm>
    <Text text="{i18n>ratesHint}" class="bsxCardPad" />
  </VBox>
</mvc:View>
