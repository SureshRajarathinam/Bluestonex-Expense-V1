<mvc:View
  controllerName="com.bluestonex.expense.approval.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:tnt="sap.tnt"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  displayBlock="true"
  height="100%">

  <tnt:ToolPage id="toolPage" class="bsxToolPage" sideExpanded="false">

    <tnt:header>
      <tnt:ToolHeader class="bsxHeader">
        <core:Icon src="sap-icon://person-placeholder" class="bsxGreetIcon" visible="{= !!${app>/greeting} }" />
        <Text text="{app>/greeting}" class="bsxGreeting" visible="{= !!${app>/greeting} }" />
      </tnt:ToolHeader>
    </tnt:header>

    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" class="bsxSideNav" selectedKey="dashboard" itemSelect=".onNavSelect">
        <tnt:NavigationList>
          <tnt:NavigationListItem key="__toggle" class="bsxNavToggle"
            tooltip="{= ${app>/sideExpanded} ? 'Collapse menu' : 'Expand menu' }"
            text="{= ${app>/sideExpanded} ? 'Collapse' : '' }"
            icon="{= ${app>/sideExpanded} ? 'sap-icon://navigation-left-arrow' : 'sap-icon://navigation-right-arrow' }" />
          <tnt:NavigationListItem key="dashboard" text="{i18n>tabDashboard}" icon="sap-icon://bar-chart" />
          <tnt:NavigationListItem key="approvals" text="{i18n>tabApprovals}" icon="sap-icon://task" />
          <tnt:NavigationListItem key="policy" text="{i18n>tabPolicy}" icon="sap-icon://settings" />
          <tnt:NavigationListItem key="workflow" text="{i18n>tabWorkflow}" icon="sap-icon://org-chart" />
          <tnt:NavigationListItem key="history" text="{i18n>tabHistory}" icon="sap-icon://history" />
        </tnt:NavigationList>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <tnt:mainContents>
      <NavContainer id="sectionNav" height="100%">
        <mvc:XMLView id="dashboardView" viewName="com.bluestonex.expense.approval.view.Dashboard" />
        <mvc:XMLView id="approvalsView" viewName="com.bluestonex.expense.approval.view.Approvals" />
        <mvc:XMLView id="policyView" viewName="com.bluestonex.expense.approval.view.Policy" />
        <mvc:XMLView id="workflowView" viewName="com.bluestonex.expense.approval.view.Workflow" />
        <mvc:XMLView id="historyView" viewName="com.bluestonex.expense.approval.view.History" />
      </NavContainer>
    </tnt:mainContents>

  </tnt:ToolPage>
</mvc:View>
