<mvc:View
  controllerName="com.bluestonex.expense.myexpenses.controller.Claim"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  height="100%">

  <Page
    id="claimPage"
    class="bsxPage"
    showNavButton="true"
    navButtonPress=".onBack"
    backgroundDesign="Transparent"
    title="{= ${claimNumber} ? ${claimNumber} : 'New Expense Claim' }">

    <content>
      <!-- Returned-for-rework banner: shows the approver's reason so the
           employee knows what to fix before re-applying for approval. -->
      <MessageStrip
        visible="{ui>/isReturned}"
        type="Warning"
        showIcon="true"
        class="sapUiSmallMargin"
        text="{= ${i18n>msgReturnedReason} + ' ' + (${ui>/returnReason} || '—') }" />

      <!-- General information -->
      <Panel class="bsxCard" headerText="{i18n>sectionGeneral}" expandable="false">
        <f:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsM="2" columnsL="2">
          <f:content>
            <Label text="{i18n>lblCountry}" />
            <ObjectStatus text="{path: 'country', formatter: '.formatter.countryText'}" state="Information" inverted="true" />
            <Label text="{i18n>lblPeriod}" required="true" />
            <DateRangeSelection
              dateValue="{path: 'claimPeriod', type: 'sap.ui.model.odata.type.Date'}"
              secondDateValue="{path: 'periodEnd', type: 'sap.ui.model.odata.type.Date'}"
              displayFormat="medium"
              width="18rem"
              editable="{ui>/editable}" />
            <Label text="{i18n>lblEmployee}" />
            <Text text="{employeeName}" />
            <Label text="{i18n>lblEmpNo}" />
            <Text text="{employeeNumber}" />
            <Label text="{i18n>lblDept}" />
            <Text text="{department}" />
            <Label text="{i18n>lblSite}" />
            <Text text="{employeeSite}" />
            <Label text="{i18n>lblPayroll}" />
            <Text text="{payrollArea}" />
            <Label text="{i18n>lblStatus}" />
            <ObjectStatus
              inverted="true"
              icon="{path: 'status', formatter: '.formatter.statusIcon'}"
              text="{path: 'status', formatter: '.formatter.statusText'}"
              state="{path: 'statusCriticality', formatter: '.formatter.statusState'}" />
            <Label text="{i18n>lblCurrency}" />
            <Text text="{currency}" />
          </f:content>
        </f:SimpleForm>

        <HBox justifyContent="End" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" wrap="Wrap">
          <VBox class="sapUiSmallMarginEnd" alignItems="End">
            <Label text="{i18n>lblNet}" /><ObjectNumber number="{ parts: ['totalNet','currency'], formatter: '.formatter.money' }" />
          </VBox>
          <VBox class="sapUiSmallMarginEnd" alignItems="End">
            <Label text="{i18n>lblTax}" /><ObjectNumber number="{ parts: ['totalVAT','currency'], formatter: '.formatter.money' }" />
          </VBox>
          <VBox alignItems="End">
            <Label text="{i18n>lblGross}" /><ObjectNumber emphasized="true" number="{ parts: ['totalGross','currency'], formatter: '.formatter.money' }" />
          </VBox>
        </HBox>
      </Panel>

      <!-- Expense items -->
      <Panel class="bsxCard" expandable="false">
        <headerToolbar>
          <Toolbar class="bsxCardPad">
            <core:Icon src="sap-icon://receipt" class="sapUiTinyMarginEnd" />
            <Title text="{i18n>sectionItems}" class="bsxCardTitle" level="H3" />
            <ObjectStatus class="sapUiTinyMarginBegin" inverted="true" state="Information" text="{ui>/itemCount}" />
            <ToolbarSpacer />
            <Button text="{i18n>btnAddItem}" icon="sap-icon://add" type="Emphasized" class="bsxPill" enabled="{ui>/editable}" press=".onAddItem" />
          </Toolbar>
        </headerToolbar>
        <Table id="itemsTable" class="bsxTable" items="{items}" updateFinished=".onItemsUpdated" mode="None">
          <columns>
            <Column width="10.5rem"><Label text="{i18n>itDate}" required="true" /></Column>
            <Column width="9rem"><Label text="{i18n>itType}" required="true" /></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Label text="{i18n>itDestination}" /></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Label text="{i18n>itReason}" required="true" /></Column>
            <Column width="8.5rem"><Label text="{i18n>itTaxType}" /></Column>
            <Column width="8.5rem" hAlign="End"><Label text="{i18n>itGross}" required="true" /></Column>
            <Column width="7.5rem" hAlign="End"><Label text="{i18n>itNet}" /></Column>
            <Column width="7.5rem" hAlign="End"><Label text="{i18n>itVat}" /></Column>
            <Column width="6.5rem" hAlign="Center"><Label text="{i18n>itAttachment}" /></Column>
            <Column width="3rem" hAlign="Center"><Text text="" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <DatePicker value="{expenseDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" editable="{ui>/editable}" width="100%" class="bsxDateCell" />
                <Select selectedKey="{expenseType_code}" editable="{ui>/editable}" forceSelection="false" width="100%"
                  items="{ path: '/ExpenseTypes', templateShareable: false }">
                  <core:Item key="{code}" text="{description}" />
                </Select>
                <Input value="{destination}" editable="{ui>/editable}" width="100%" />
                <Input value="{reasonForTrip}" editable="{ui>/editable}" width="100%" />
                <Select selectedKey="{vatType}" editable="{ui>/editable}" forceSelection="false" width="100%"
                  items="{ path: '/VATTypes', templateShareable: false }">
                  <core:Item key="{code}" text="{description}" />
                </Select>
                <!-- No type="Number": an HTML number input can't hold a grouped value
                     (e.g. "9,891.00"), which capped amounts at 3 digits. A text input
                     bound to the OData Decimal(15,2) type accepts large amounts and
                     formats 2 decimals per the locale/currency. -->
                <Input value="{grossAmount}" textAlign="End" editable="{ui>/editable}" width="100%" />
                <Text textAlign="End" text="{ parts: [{path: 'netAmount'}, {path: 'grossAmount'}, {path: 'vatType'}, {path: 'ui>/stdRate'}, {path: 'ui>/editable'}, {path: 'ui>/currency'}], formatter: '.formatter.netPreview' }" />
                <Text textAlign="End" text="{ parts: [{path: 'vatAmount'}, {path: 'grossAmount'}, {path: 'vatType'}, {path: 'ui>/stdRate'}, {path: 'ui>/editable'}, {path: 'ui>/currency'}], formatter: '.formatter.vatPreview' }" />
                <HBox alignItems="Center" justifyContent="Center">
                  <!-- Compact receipt status: a small green tick when a receipt is
                       attached (filename shown as tooltip / via View), nothing when
                       not. Frees the column so it needs far less width. -->
                  <core:Icon src="sap-icon://sys-enter-2" color="#107e3e" size="1.15rem"
                    tooltip="{path: 'receiptFileName'}" visible="{= !!${receiptFileName} }" press=".onViewReceipt" class="bsxReceiptOk" />
                  <Button icon="sap-icon://attachment" type="Transparent" tooltip="{i18n>btnUpload}" enabled="{ui>/editable}" press=".onUploadReceipt" />
                </HBox>
                <Button icon="sap-icon://delete" type="Transparent" class="bsxDanger" tooltip="{i18n>btnDelete}" enabled="{ui>/editable}" press=".onDeleteItem" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

      <!-- Mileage -->
      <Panel class="bsxCard" expandable="false">
        <headerToolbar>
          <Toolbar class="bsxCardPad">
            <core:Icon src="sap-icon://car-rental" class="sapUiTinyMarginEnd" />
            <Title text="{i18n>sectionMileage}" class="bsxCardTitle" level="H3" />
            <ObjectStatus class="sapUiTinyMarginBegin" inverted="true" state="Information" text="{ui>/mileageCount}" />
            <ToolbarSpacer />
            <Button text="{i18n>btnAddMileage}" icon="sap-icon://add" type="Emphasized" class="bsxPill" enabled="{ui>/editable}" press=".onAddMileage" />
          </Toolbar>
        </headerToolbar>
        <Table id="mileageTable" class="bsxTable" items="{mileageClaims}" updateFinished=".onMileageUpdated" mode="None">
          <columns>
            <Column width="11rem"><Label text="{i18n>mlDate}" required="true" /></Column>
            <Column><Label text="{i18n>mlDestination}" required="true" /></Column>
            <Column><Label text="{i18n>mlReason}" required="true" /></Column>
            <Column width="9rem"><Label text="{i18n>mlEngine}" /></Column>
            <Column width="7rem" hAlign="End"><Label text="{i18n>mlMiles}" required="true" /></Column>
            <Column width="7rem" hAlign="End"><Label text="{i18n>mlRate}" /></Column>
            <Column width="3.5rem" hAlign="Center"><Text text="" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <DatePicker value="{tripDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" editable="{ui>/editable}" width="100%" class="bsxDateCell" />
                <Input value="{destination}" editable="{ui>/editable}" width="100%" />
                <Input value="{reasonForTrip}" editable="{ui>/editable}" width="100%" />
                <Select selectedKey="{engineType}" editable="{ui>/editable}" forceSelection="false" width="100%">
                  <core:Item key="Petrol" text="Petrol" />
                  <core:Item key="Diesel" text="Diesel" />
                  <core:Item key="Hybrid" text="Hybrid" />
                  <core:Item key="Electric" text="Electric" />
                </Select>
                <Input value="{milesCount}" textAlign="End" editable="{ui>/editable}" width="100%" />
                <Input value="{ratePerMile}" textAlign="End" editable="{ui>/editable}" width="100%" />
                <Button icon="sap-icon://delete" type="Transparent" class="bsxDanger" tooltip="{i18n>btnDelete}" enabled="{ui>/editable}" press=".onDeleteMileage" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </content>

    <footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button text="Edit" icon="sap-icon://edit" class="bsxPill" visible="{ui>/canEdit}" press=".onEdit" />
        <Button text="{i18n>btnDiscard}" type="Transparent" class="bsxPill" visible="{ui>/editable}" press=".onDiscard" />
        <Button text="{i18n>btnSave}" class="bsxPill" visible="{ui>/editable}" press=".onSave" />
        <Button text="{i18n>btnSubmit}" type="Emphasized" class="bsxPill" visible="{ui>/canSubmit}" press=".onSubmit" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
